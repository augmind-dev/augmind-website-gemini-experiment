{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/blissful-allen-tamn6c": true,
      "claude/dark-gradient-preview": true,
      "claude/alternating-preview": true
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/how-it-works",
      "destination": "/#how",
      "permanent": true
    },
    {
      "source": "/the-problem",
      "destination": "/#tg-h",
      "permanent": true
    },
    {
      "source": "/digital-marketing-audit",
      "destination": "/#how",
      "permanent": true
    },
    {
      "source": "/marketing-system-build",
      "destination": "/#how",
      "permanent": true
    },
    {
      "source": "/ai-consulting",
      "destination": "/ai-search",
      "permanent": true
    },
    {
      "source": "/discover",
      "destination": "/#how",
      "permanent": true
    },
    {
      "source": "/implement",
      "destination": "/#how",
      "permanent": true
    },
    {
      "source": "/run",
      "destination": "/#how",
      "permanent": true
    },
    {
      "source": "/approve-the-plan",
      "destination": "/#how",
      "permanent": true
    },
    {
      "source": "/have-us-run-it",
      "destination": "/#how",
      "permanent": true
    },
    {
      "source": "/free-consultation",
      "destination": "/scheduling",
      "permanent": true
    },
    {
      "source": "/discover-quote",
      "destination": "/scheduling",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/index.md",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.augmind.ai/>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/team/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
