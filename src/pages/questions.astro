---
/** All the questions, in groups, with FAQPage JSON-LD. Answers live in src/data/faqs.ts. */
import Base from '../layouts/Base.astro';
import FaqList from '../components/FaqList.astro';
import { faqs, faqGroups } from '../data/faqs';
const count = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen'][faqs.length] ?? String(faqs.length);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title="Questions about Discover, the Decision Brief and AI search | AugMind" canon="questions" cur="q" sticky="/#consult" ld={ld}
  description={`${count} short answers about AugMind, the Decision Brief, Discover, and AI search (GEO).`}>
<div class="w pg-h"><h1>Questions buyers ask first</h1><p>{count} short answers about AugMind, the Decision Brief, and AI search (GEO).</p></div>
<div class="w"><div style="max-width:820px;padding-bottom:88px">
{faqGroups.map((g) => <section class="qgrp" aria-labelledby={`g-${slug(g)}`}><h2 id={`g-${slug(g)}`}>{g}</h2><FaqList items={faqs.filter((f) => f.g === g)} ids /></section>)}
<div class="endcta"><h2>Still deciding? Ask a partner directly.</h2><p>Pick a time to talk with a partner.</p><a class="btn btn-w" href="/#consult">Request a consultation</a></div>
</div></div>
</Base>
