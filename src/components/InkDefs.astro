---
/** One copy per page of the filter and dot pattern the inked drawings use (#ink-rough, #ink-dots). */
---
<svg class="ink-defs" width="0" height="0" aria-hidden="true" focusable="false"><defs><filter id="ink-rough" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7"/><feDisplacementMap in="SourceGraphic" scale="3.2"/></filter><pattern id="ink-dots" width="7" height="7" patternUnits="userSpaceOnUse"><circle cx="3.5" cy="3.5" r="1.5"/></pattern></defs></svg>
