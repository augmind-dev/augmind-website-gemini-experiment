---
/** Each outcome pill carries an icon as well as its words and colour, so it never depends on colour alone (WCAG 1.4.1).
 * Truth-gap card: three example leads traced to sales records and stamped (motion in site.js: .trace.is-in). */
import { I } from '../lib/icons';
const leads = [
  { src: 'Search web form', path: 'Matched to a paid invoice 12 days later', out: 'Confirmed sale', k: 'ok' },
  { src: 'Social phone call', path: 'Same phone, different billing name', out: 'Person reviews', k: 'rev' },
  { src: 'Map web form', path: 'Nothing in 90 days of sales records', out: 'No sale found', k: 'no' },
];
---
<div class="sort">
  <h3>How every reported lead is sorted</h3><p class="n">Three traced examples</p>
  <ul class="trace" data-play>
    {leads.map((l, i) => <li style={`--i:${i}`}><span class="src">{l.src}</span><span class="path"><Fragment set:html={I.arrow} />{l.path}</span><span class={`out out-${l.k}`}><Fragment set:html={l.k === 'ok' ? I.tick : l.k === 'rev' ? I.review : I.x} />{l.out}</span></li>)}
  </ul>
</div>
